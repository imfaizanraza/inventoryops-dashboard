# ==============================================================================
# Helfen Operations Hub — Environment Configuration Template (.env.example)
# Copy this file to .env and populate with your credentials.
# NEVER commit your actual .env file or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Shopify GraphQL Admin API Configuration
# ------------------------------------------------------------------------------
# Your development store myshopify domain (e.g., your-store.myshopify.com)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Shopify Admin API version (recommended: 2026-10 or latest stable)
SHOPIFY_API_VERSION=2026-10

# Shopify Dev Dashboard App Client Credentials
# (For custom apps created in your Shopify Dev Dashboard / Partner organization)
SHOPIFY_CLIENT_ID=your_client_id_here
SHOPIFY_CLIENT_SECRET=your_client_secret_here

# ------------------------------------------------------------------------------
# Google Sheets API Configuration
# ------------------------------------------------------------------------------
# Method: Service Account JSON Key (Recommended for automated server integrations)
# Path to your downloaded service account JSON key file (e.g., service_account.json)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# ID of the Google Spreadsheet (found in the URL between /d/ and /edit)
# Example: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit
GOOGLE_SHEET_ID=your_spreadsheet_id_here
